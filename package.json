{
  "name": "browser-extensions",
  "private": true,
  "description": "Private browser extension monorepo.",
  "type": "module",
  "scripts": {
    "build": "turbo run build && pnpm normalize:archives",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint scripts tests && turbo run lint",
    "normalize:archives": "node scripts/normalize-archives.mjs",
    "smoke:chromium": "node scripts/smoke-chromium.mjs",
    "test": "turbo run test:unit",
    "test:archives": "node --test tests/archive-contents.test.mjs",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm normalize:archives && pnpm test:archives"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "turbo": "2.10.8"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
