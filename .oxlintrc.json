{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-debugger": "error",
    "no-eval": "error",
    "unicorn/prefer-node-protocol": "error"
  },
  "env": {
    "builtin": true
  }
}
