{
  "name": "@browser-extensions/npmjs-to-npmx",
  "version": "1.0.0",
  "private": true,
  "description": "Redirect compatible npmjs.com pages to npmx.dev.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "lint": "oxlint src scripts test",
    "test": "pnpm run build && pnpm run test:unit",
    "test:unit": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "0.2.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
