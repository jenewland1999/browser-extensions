{
  "manifest_version": 3,
  "name": "Tessera",
  "description": "Build a calm, structured new tab page from nested sections and links.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["favicon", "storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
